# ==============================================================================
# Vulnora AI Backend - Environment Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-secret-key-32chars+
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
DJANGO_SETTINGS_MODULE=vulnora.settings.development

# Database Configuration (SQLite default; switch to postgres://user:pass@host:5432/dbname in prod)
DATABASE_URL=sqlite:///db.sqlite3

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Vulnora Platform Integration Settings (For subsequent phases)
# ==============================================================================

# Remote AI Inference Server (Ollama / Remote Laptop)
VULNORA_REMOTE_AI_ENDPOINT=http://127.0.0.1:11434
VULNORA_REMOTE_AI_MODEL=qwen2.5-coder:7b
VULNORA_REMOTE_AI_TIMEOUT_SECONDS=60

# CLI & Branch Protection Defaults
VULNORA_PROTECTED_BRANCHES=main,production
VULNORA_AUTO_REMEDIATE=False

