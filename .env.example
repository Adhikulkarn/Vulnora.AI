# Vulnora AI Environment Configuration Template
# Copy this file to .env and fill in your API keys.

# -----------------------------------------------------------------------------
# Google Gemini API Key (Recommended for fast, low-latency Cloud AI remediation)
# Get a key at: https://aistudio.google.com/
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# -----------------------------------------------------------------------------
# GroqCloud API Key (For ultra-fast Llama-3.3-70b / Llama-3.1-8b inference)
# Get a key at: https://console.groq.com/
# -----------------------------------------------------------------------------
GROQ_API_KEY="your-groq-api-key-here"

# -----------------------------------------------------------------------------
# OpenAI API Key (For GPT-4o-mini / OpenAI-compatible endpoints)
# -----------------------------------------------------------------------------
OPENAI_API_KEY="your-openai-api-key-here"

# -----------------------------------------------------------------------------
# AI Provider & Model Configuration
# Supported providers: gemini | groq | ollama | openai
# -----------------------------------------------------------------------------
VULNORA_AI_PROVIDER="gemini"
VULNORA_AI_MODEL="gemini-2.5-flash"
# VULNORA_AI_ENDPOINT="http://localhost:11434"
